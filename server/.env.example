# GBG Go API Credentials
# Obtain these from your GBG account representative or the GBG Go portal.
GO_CLIENT_ID=your-client-id
GO_CLIENT_SECRET=your-client-secret
GO_USERNAME=api-user@example.com
GO_PASSWORD=your-password

# Regional server index: 0 = EU, 1 = US, 2 = AU
GO_SERVER_IDX=0

# Default resource ID for journeys
GO_RESOURCE_ID=a4c68509c24789888eb466@latest

# GBG Go Captain API base URL (optional). Set only to target a custom or
# non-production environment; include the /v2/captain suffix. When set it
# overrides GO_SERVER_IDX.
# GO_SERVER_URL=https://your-environment.example.com/v2/captain

# Token endpoint host (optional). The SDK uses the production auth host by
# default; set this only if your environment issues tokens elsewhere.
# GO_AUTH_URL=https://auth.your-environment.example.com

# Server port (default: 3000)
PORT=3000
